SECRET_KEY=replace-with-strong-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ADMIN_EMAIL=admin@det.com
DATABASE_URL=sqlite:///./expiry_tracker.db
ENABLE_DEMO_USER=true
# Local-only demo account password. Leave empty to skip demo-user creation.
# Never set a real password here in a committed file.
DEMO_USER_PASSWORD=change-me-local-only
TESSERACT_CMD=
# Backward-compatible alias; leave unset if paths are discovered automatically:
# TESSERACT_PATH=tesseract
OCR_TIMEOUT_SECONDS=30
APP_ENV=development
SESSION_COOKIE_SECURE=false
# Comma-separated explicit origins only; do not use "*" with session cookies.
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000
FRONTEND_URL=
UPLOAD_DIR=uploads
ENABLE_OCR=true
MAX_UPLOAD_SIZE_BYTES=10485760
GOOGLE_CLIENT_ID=your_client_id
GOOGLE_CLIENT_SECRET=your_client_secret
